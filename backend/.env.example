# Local PostgreSQL connection. Use a dedicated least-privilege application role.
DATABASE_URL=postgresql://sapphirix_app:replace-me@127.0.0.1:5432/sapphirix_pp
# Set true only when the PostgreSQL server requires TLS and its CA is trusted.
DATABASE_SSL=false

# Firebase project used by the API verifier; never commit service-account keys.
FIREBASE_PROJECT_ID=your-firebase-project-id
# On the host, point this to a service-account file outside the repository,
# or configure Google Application Default Credentials through the environment.
GOOGLE_APPLICATION_CREDENTIALS=/etc/sapphirix/firebase-admin.json

# Optional legacy local-only companion token. Do not configure for production;
# replace this endpoint with scoped character sync credentials before deployment.
COMPANION_SYNC_TOKEN=
HOST=127.0.0.1
PORT=3000
